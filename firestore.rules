rules_version = '2';

// Order App security rules: many restaurants, each a paying customer.
//
// Who is who:
//   - The company (you): Google accounts listed in company/{email}. Approves restaurants, records
//     payments, suspends, changes owners. The first sign-in on the company page claims it.
//   - A restaurant's account: accounts/{rid}. Its status ('pending', 'active', 'suspended'), the date it
//     is paid until, and the owner's Google email. Only the company changes it.
//   - A restaurant runs while it is active and paid up, plus a 7-day grace week. After that diners,
//     staff and managers are blocked by these rules; the owner can still sign in and see why.
//   - Inside a restaurant (restaurants/{rid}/...):
//       owner = the account's owner email; managers = admins/{email}, added by the owner;
//       staff phones = staff/{uid} holding the current staff token (from the Setup page QR);
//       diners = anyone with a pass (passes/{uid}) proving the table's QR key or an open group's code.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function email() { return request.auth.token.get('email', '-'); }
    function verified() { return signedIn() && request.auth.token.get('email_verified', false) == true; }

    // ---------- the company ----------
    function isCompany() { return verified() && exists(/databases/$(database)/documents/company/$(email())); }

    match /meta/company {
      allow read: if true;
      // The first company admin: allowed once, together with their own company entry.
      allow create: if verified() && request.resource.data.by == email()
        && existsAfter(/databases/$(database)/documents/company/$(email()));
      allow update, delete: if false;
    }
    match /company/{em} {
      allow read: if isCompany() || (verified() && em == email());
      allow create: if verified() && request.resource.data.keys().hasOnly(['name', 'by', 't'])
        && (isCompany()
            || (em == email() && !exists(/databases/$(database)/documents/meta/company)
                && existsAfter(/databases/$(database)/documents/meta/company)));
      allow update: if false;
      allow delete: if isCompany() && em != email();
    }

    // ---------- restaurant accounts (subscriptions) ----------
    function acct(rid) { return get(/databases/$(database)/documents/accounts/$(rid)).data; }
    // Active and paid up, or within 7 days of the paid-until date.
    function live(rid) {
      let a = acct(rid);
      return a.status == 'active' && a.paidUntil is int
        && request.time.toMillis() < a.paidUntil + 7 * 24 * 60 * 60 * 1000;
    }
    function isOwner(rid) { return verified() && acct(rid).ownerEmail == email(); }
    function isManager(rid) { return verified() && exists(/databases/$(database)/documents/restaurants/$(rid)/admins/$(email())); }
    function isAdmin(rid) { return isOwner(rid) || isManager(rid); }
    // Owner or manager of a restaurant that's running (or the company, for support).
    function boss(rid) { return isCompany() || (live(rid) && isAdmin(rid)); }
    function bossOwner(rid) { return isCompany() || (live(rid) && isOwner(rid)); }

    match /accounts/{rid} {
      allow get: if isCompany() || isAdmin(rid);
      allow list: if isCompany() || (verified() && resource.data.ownerEmail == email());
      // A restaurant applies: it starts as pending, with no paid-until date, owned by whoever applied.
      allow create: if isCompany()
        || (verified() && rid.matches('^[a-z0-9-]{3,40}$')
            && request.resource.data.keys().hasOnly(['name', 'ownerEmail', 'ownerName', 'phone', 'area', 'tables', 'status', 'created'])
            && request.resource.data.status == 'pending'
            && request.resource.data.ownerEmail == email()
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60);
      allow update, delete: if isCompany();
    }

    // Payments the company records against an account (history for the company and the owner).
    match /accounts/{rid}/payments/{pid} {
      allow read: if isCompany() || isOwner(rid);
      allow create: if isCompany();
      allow update, delete: if false;
    }

    // Managers find the restaurants they help run (a search across every restaurant's admins list).
    match /{path=**}/admins/{em} {
      allow list: if verified() && resource.data.email == email();
    }

    // ---------- inside one restaurant ----------
    match /restaurants/{rid} {
      function staffPath() { return /databases/$(database)/documents/restaurants/$(rid)/staff/$(me()); }
      function staffToken() { return get(/databases/$(database)/documents/restaurants/$(rid)/secrets/staff).data.token; }
      function isStaffPhone() { return signedIn() && exists(staffPath()) && get(staffPath()).data.token == staffToken(); }
      function isStaff() { return isCompany() || (live(rid) && (isStaffPhone() || isAdmin(rid))); }

      function passPath() { return /databases/$(database)/documents/restaurants/$(rid)/passes/$(me()); }
      function hasPass() { return signedIn() && exists(passPath()); }
      function pass() { return get(passPath()).data; }
      function keyOk(p) {
        return p.via == 'key' && p.k is string
          && p.k == get(/databases/$(database)/documents/restaurants/$(rid)/tablekeys/$(string(p.table))).data.k;
      }
      function keyPassFor(n) { return live(rid) && hasPass() && pass().via == 'key' && pass().table == n && keyOk(pass()); }
      function inSession(sid) { return live(rid) && hasPass() && pass().session == sid; }
      function groupAfter(sid) { return getAfter(/databases/$(database)/documents/restaurants/$(rid)/groups/$(sid)).data; }
      function groupNow(sid) { return get(/databases/$(database)/documents/restaurants/$(rid)/groups/$(sid)).data; }
      function validPass(p) {
        return p.keys().hasOnly(['table', 'via', 'k', 'c', 'session', 't']) && p.table is int
          && ((keyOk(p) && (p.get('session', null) == null
                || (groupAfter(p.session).table == p.table && groupAfter(p.session).open == true)))
            || (p.via == 'code' && p.c is string && p.session is string
                && get(/databases/$(database)/documents/restaurants/$(rid)/codes/$(p.c)).data.session == p.session
                && groupNow(p.session).open == true && groupNow(p.session).table == p.table));
      }

      // The restaurant document itself is its settings: menu, prices, waiters, look, shared tables.
      // Public while the restaurant is running; the owner and managers can always see it.
      allow read: if live(rid) || isCompany() || isAdmin(rid);
      allow create: if boss(rid);
      allow update: if bossOwner(rid)
        || (boss(rid) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['sections', 'waiters', 'shared', 'prices', 'tables', 'updated']));
      allow delete: if isCompany();

      match /photos/{id} {
        allow read: if true;
        allow create: if boss(rid) && request.resource.data.data is string;
        allow delete: if boss(rid);
        allow update: if false;
      }
      match /admins/{em} {
        allow read: if isCompany() || isAdmin(rid);
        allow create, update: if bossOwner(rid) && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'by', 't'])
          && request.resource.data.role == 'manager' && request.resource.data.email == em;
        allow delete: if bossOwner(rid);
      }
      match /secrets/staff {
        allow read, write: if boss(rid);
      }
      match /staff/{uid} {
        allow get: if signedIn() && (uid == me() || boss(rid));
        allow list: if boss(rid);
        allow create, update: if live(rid) && signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['token', 't'])
          && request.resource.data.token == staffToken();
        allow delete: if signedIn() && (uid == me() || boss(rid));
      }
      match /tablekeys/{n} {
        allow read, write: if boss(rid);
      }
      match /passes/{uid} {
        allow get: if signedIn() && uid == me();
        allow list: if boss(rid);
        allow delete: if boss(rid) || (signedIn() && uid == me());
        allow create, update: if live(rid) && signedIn() && uid == me() && validPass(request.resource.data);
      }
      match /tables/{n} {
        allow read: if isStaff() || keyPassFor(int(n));
        allow write: if isStaff()
          || (keyPassFor(int(n)) && request.resource.data.keys().hasOnly(['table', 'current'])
              && request.resource.data.table == int(n)
              && groupAfter(request.resource.data.current).table == int(n)
              && groupAfter(request.resource.data.current).open == true);
      }
      match /codes/{code} {
        function newCode() {
          return request.resource.data.keys().hasOnly(['session', 'table'])
            && groupAfter(request.resource.data.session).code == code
            && groupAfter(request.resource.data.session).table == request.resource.data.table
            && groupAfter(request.resource.data.session).open == true;
        }
        allow get: if signedIn() && live(rid);
        allow list: if isStaff();
        allow create: if (isStaff() || keyPassFor(request.resource.data.table)) && newCode();
        allow update: if (isStaff() || keyPassFor(request.resource.data.table)) && newCode()
          && groupNow(resource.data.session).open == false;
        allow delete: if isStaff();
      }
      match /groups/{sid} {
        function dinerEdit() {
          let d = request.resource.data;
          let changed = d.diff(resource.data).affectedKeys();
          let ppl = d.people.diff(resource.data.people);
          return changed.hasOnly(['people', 'label', 'split'])
            && d.split in ['order', 'equal']
            && ppl.removedKeys().size() == 0
            && ppl.addedKeys().union(ppl.changedKeys()).hasOnly([me()])
            && (!(me() in d.people) || validPerson(d.people[me()]))
            && (!changed.hasAny(['label']) || resource.data.label == null);
        }
        function validPerson(p) {
          return p.keys().hasOnly(['name', 't', 'uid', 'acct'])
            && p.name is string && p.name.size() > 0 && p.name.size() <= 20 && p.uid == me();
        }
        allow get: if isStaff() || inSession(sid) || keyPassFor(resource.data.table);
        allow list: if isStaff() || keyPassFor(resource.data.table);
        allow create: if isStaff()
          || (keyPassFor(request.resource.data.table)
              && request.resource.data.session == sid && request.resource.data.open == true
              && request.resource.data.waiter == null && request.resource.data.people.size() == 0
              && request.resource.data.paid.size() == 0
              && request.resource.data.code is string && request.resource.data.code.size() == 4);
        allow update: if isStaff() || (inSession(sid) && resource.data.open == true && dinerEdit());
        allow delete: if boss(rid);
      }
      match /lines/{id} {
        function dinerLine(l) {
          let g = groupNow(l.session);
          let price = get(/databases/$(database)/documents/restaurants/$(rid)).data.prices.get(l.n + '|' + l.v, null);
          return inSession(l.session) && g.open == true && me() in g.people
            && l.keys().hasOnly(['table', 'session', 'batch', 'pid', 'pname', 'n', 'v', 'pr', 'st', 's', 't', 'note'])
            && l.pid == me() && l.table == g.table && l.s == 'new'
            && l.n is string && l.v is string
            && price != null && l.pr == price.p && l.st == price.st
            && (l.note == null || (l.note is string && l.note.size() <= 200));
        }
        allow read: if isStaff() || (hasPass() && live(rid) && resource.data.session == pass().session);
        allow create: if boss(rid) || dinerLine(request.resource.data);
        allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['s', 'tPrep', 'tReady', 'tServed', 'servedBy', 'closedUnserved']);
        allow delete: if boss(rid);
      }
      match /alerts/{id} {
        function dinerAlert(a) {
          let g = groupNow(a.session);
          return inSession(a.session) && g.open == true && me() in g.people
            && a.keys().hasOnly(['table', 'session', 'type', 'pid', 'pname', 't', 'ack', 'ackBy', 'done'])
            && a.type in ['call', 'bill'] && a.pid == me() && a.table == g.table
            && a.ack == null && a.ackBy == null && a.done == false;
        }
        allow read: if isStaff() || (hasPass() && live(rid) && resource.data.session == pass().session);
        allow create: if boss(rid) || dinerAlert(request.resource.data);
        allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ack', 'ackBy', 'done', 'doneAt']);
        allow delete: if boss(rid);
      }
      match /sessions/{sid} {
        allow read: if boss(rid);
        allow create: if isStaff();
        allow update, delete: if boss(rid);
      }
    }

    // ---------- diner accounts (shared across restaurants) ----------
    match /diners/{uid} {
      allow read, write: if signedIn() && uid == me();
    }
    match /visits/{id} {
      allow read: if signedIn() && (resource.data.uid == me() || boss(resource.data.rid));
      allow create: if request.resource.data.uid is string && request.resource.data.rid is string
        && (isCompany() || (live(request.resource.data.rid)
            && (exists(/databases/$(database)/documents/restaurants/$(request.resource.data.rid)/staff/$(me()))
                && get(/databases/$(database)/documents/restaurants/$(request.resource.data.rid)/staff/$(me())).data.token
                   == get(/databases/$(database)/documents/restaurants/$(request.resource.data.rid)/secrets/staff).data.token
              || isAdmin(request.resource.data.rid))));
      allow delete: if signedIn() && (resource.data.uid == me() || boss(resource.data.rid));
      allow update: if false;
    }
  }
}
